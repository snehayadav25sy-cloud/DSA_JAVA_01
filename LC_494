class Solution {

    public int SumWays(int[] nums, int target , int index ,int sum){
       
        if(index == nums.length){
            if(sum == target){
                return 1;
            }

            return 0 ; 
        }

            int add =SumWays( nums, target , index+1 , sum+nums[index]  );
            int sub =SumWays( nums, target , index+1 , sum-nums[index]  );

        

        return add+sub;


    }
    public int findTargetSumWays(int[] nums, int target ) {
       return SumWays( nums, target , 0 , 0 );
      
        
    }
}
