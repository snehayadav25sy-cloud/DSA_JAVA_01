class Solution {
    public void reverseString(char[] s , int left , int right) {
        
        while(left>=right){
            return ;
        }

        char temp = s[left];
        s[left]=s[right];
        s[right] = temp;
        

        reverseString(s , left+1 , right-1);
        
    }

    public void reverseString(char[] s ){
        reverseString( s , 0 , s.length-1);
    }
}
