class Solution {
    public List<List<Integer>> subsetsWithDup(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        List<Integer> curr = new ArrayList<>();
        Arrays.sort(nums);
        int n = nums.length;
        int index = 0 ;

        Backtrack(index , nums , n , ans , curr);
        return ans;
        
    }

    public void Backtrack(int index , int[] nums , int n , List<List<Integer>> ans ,List<Integer> curr) {
        ans.add(new ArrayList<>(curr));

        for(int i = index ; i< n ; i++){
            if(i!= index && nums[i]==nums[i-1]) continue;

            curr.add(nums[i]);
            Backtrack(i+1 , nums , n , ans , curr);
            curr.remove(curr.size()-1);
        }
    }

}
