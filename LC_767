class Solution {
    public ListNode addOne(ListNode head) {
        int carry = Helper(head);

        if(carry==1){
            ListNode newNode = new ListNode(1);
            newNode.next = head;
            return newNode
        }
        return head;

    }

    public int Helper(ListNode temp){
        if(temp==null){
            return 1;
        }

        int carry = Helper(temp.next);
        temp.data = temp.data+carry;

        if(temp.data<10){
            return 0
        }
        temp.data = 0;
        return 1;
    }

}
