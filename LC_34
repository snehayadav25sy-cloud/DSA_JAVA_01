class Solution {
    public int[] searchRange(int[] nums, int target) {
        int n = first(nums,target);
        int m = last(nums , target);
        return new int[]{n,m};
    }

    private int first(int[] nums , int target){
        int n = nums.length;
        int low=0;
        int high= n-1;
        int f= -1;

        while(low<=high){
            int mid=low+(high-low)/2;
            if(nums[mid]==target){
                f = mid;
                high = mid-1;
            }else if(nums[mid]<target){
                low = mid+1;
            }else{
                high = mid-1;
            }
        }
       return f;
    }

    private int last(int[] nums , int target){
        int n= nums.length;
        int low=0;
        int high= n-1;
        int l=-1;

        while(low<=high){
           int mid=low+(high-low)/2;
            if(nums[mid]==target){
                l = mid;
                low = mid+1;
            }else if(nums[mid]<target){
                low = mid+1;
            }else{
                high = mid-1;
            }
        }
       return l;
    }
}
