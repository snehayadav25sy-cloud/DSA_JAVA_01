class Solution {
    public int characterReplacement(String s, int k) {
        int[] hash = new int[26];
        int l = 0;
        int r = 0;
        int maxlen = 0;
        int maxfreq = 0;

        while(r<s.length()){

           hash[s.charAt(r)-'A']++;
           maxfreq = Math.max(maxfreq , hash[s.charAt(r)-'A'] );

           int required = (r-l+1) - maxfreq ;

           if(required <= k){
            int len = r-l+1;
            maxlen = Math.max(maxlen , len);
           }

            while((r-l+1) - maxfreq > k){
                hash[s.charAt(l)-'A']--;
                l++;
            }
           
           r++; 

        }
        return maxlen;
        
    }
}
