class Solution {
    public String removeDuplicates(String s) {
        int n = s.length();
        String ans = "";

        Stack<Character> st = new Stack<>();

        for(int i = 0 ; i<n ; i++){
            if(!st.isEmpty() && st.peek() == s.charAt(i)){
                st.pop();
            }
            else{
                st.push(s.charAt(i));
            }
            
        }

        while(!st.isEmpty()) {
            ans = st.pop() + ans;
           
        }

        return ans ; 
    }
}
