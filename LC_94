class Solution {
    public int totalFruit(int[] fruits) {
        int l = 0;
        int r = 0;
        int maxlen = 0;

        HashMap<Integer , Integer> map = new HashMap<>();

        while(r<fruits.length){
            int count = map.getOrDefault(fruits[r] , 0);
            count++;
            map.put(fruits[r] , count);

            while(map.size()>2){
                int removecount = map.get(fruits[l]);
                removecount--;

                map.put(fruits[l] , removecount);

                if(removecount == 0 ){
                    map.remove(fruits[l]);
                }

                l++;
            }

            int len = r-l+1;
            maxlen = Math.max(maxlen , len);
            
            r++;

        }
        return maxlen;
        
    }
}
