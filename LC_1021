class Solution {
    public String removeOuterParentheses(String s) {
        String ans = "";
        Stack<Character>st = new Stack<>() ; 

        for(char ch : s.toCharArray()){
            if(ch=='('){
                if(!st.isEmpty()) ans+=ch;
                st.push(ch);
            }else{
                st.pop();
                if(!st.isEmpty()) ans+=ch;
            }
        }
       return ans; 
    }
    
}
