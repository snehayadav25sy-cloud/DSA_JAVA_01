class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int n = piles.length;
        int low = 0;
        int high = 0;
        int ans =0;

        for(int max : piles){
            high = Math.max(max,high);
        }

        ans = high;

        while(low<=high){
            int mid = (low+high)/2;
            long hours = 0;

            for(int ban : piles){
                hours += (int) Math.ceil((double) ban /mid);
            }

            if(hours<=h){
                ans = mid;
                high = mid-1;
            }else{
                low=mid+1;
            }

        }
        return low;
    }
}
