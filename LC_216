class Solution {
    public List<List<Integer>> combinationSum3(int k, int n) {
        List<List<Integer>> ans = new ArrayList<>();
        List<Integer> curr = new ArrayList<>();
        int index = 1 ;
        int sum = 0;
        Backtrack(index , ans , curr,  k, n , sum);
        return ans;

        
    }

    public void Backtrack(int index ,List<List<Integer>> ans,List<Integer> curr, int k, int n , int sum){
       if(curr.size()== k){
        if(sum == n){
            ans.add(new ArrayList<>(curr));
            return;
        }
       }

       for(int i = index ; i<=9; i++){
        if(sum>n){
            return ; 
        }
          curr.add(i);
          Backtrack(i+1 , ans , curr , k , n , sum+i);
          curr.remove(curr.size()-1);
       }


    }
}
