class Solution {
    public void generate(int n , int open , int close ,List<String> ans , String curr) {
           if(open == n && close == n){
            ans.add(curr);
            return ;
           }

           if(open<n){
            generate(n , open+1 , close , ans ,curr + "(");
           }

           if(close<open){
            generate(n , open , close+1 , ans ,curr + ")");
           }
        
    }

    public List<String> generateParenthesis(int n) {
        List<String> ans = new ArrayList<>();
        generate(n , 0 , 0 , ans , "");
        return ans;
    }
}
