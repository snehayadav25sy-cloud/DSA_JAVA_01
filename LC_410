class Solution {

    private boolean MinSum (int[] nums , int capacity, int k){
        int cnt = 1; int add = 0;
        for(int i = 0 ; i <nums.length ; i++){
           if(add+nums[i]<= capacity){
               add+=nums[i];
           }else {
             cnt++;
             add=nums[i];
           }
        }
        if(cnt<=k)return true;
        else return false;
    }
    public int splitArray(int[] nums, int k) {
        int n = nums.length;
        int low = 0;
        int high=0;
        for(int s : nums){
          low = Math.max(low,s);
          high += s;  
        }

        int ans = high;
        while(low<=high){
            int mid = (low+high)/2;
            if(MinSum(nums , mid , k )==true){
                     ans=mid;
                     high = mid-1;
        }   else{
               low = mid+1;
        }
        
    }

    return ans;
}

}
