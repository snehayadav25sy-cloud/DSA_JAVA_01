class Solution {
    public List<String> findPath(int[][] maze) {
        List<String> ans= new ArrayList<>();
        String path = "";
        int n = maze.length;
        if(maze[0][0] == 0 || maze[n-1][n-1] == 0) {
        return ans;
        }
        boolean[][] visited = new boolean[n][n];
        visited[0][0] = true;
        Backtrack(maze ,0 , 0, ans , path , visited);
        return ans;
    }

    public void Backtrack(int[][]maze , int row , int col ,List<String> ans, String path, boolean[][] visited) {
        int n = maze.length;
        if(col==n-1 && row==n-1){
            ans.add(path);
            return;
        }
    

        int[] dr = {1,-1,0 ,0};
        int[] dc = {0 ,0,1,-1};

        String[] direction = {"D","U","R","L"};

        for(int i = 0 ; i<4 ; i++){
            int newrow = row+dr[i];
            int newcol = col+dc[i];

            if(issafe(newrow , newcol ,visited , maze)){
                visited[newrow][newcol]=true;
                path+=direction[i];
                Backtrack(maze , newrow , newcol ,ans,path , visited);
                path=path.substring(0 , path.length()-1);
                visited[newrow][newcol]=false;

            }
        }
        return ;
    }

    public boolean issafe(int row , int col , boolean[][] visited ,int[][] maze){
        int n = maze.length;
       if(row<n && row>=0 && 
             col<n && col>=0 &&
             !visited[row][col]&&
             maze[row][col]==1){

              return true;


             }

             return false;


    }


}










